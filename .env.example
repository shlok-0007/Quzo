# Copy this file to `.env` for local development.
# On Vercel, add these as Project Settings -> Environment Variables.

# Required in production. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Google Gemini API key used by the AI quiz generator.
GEMINI_API_KEY=your-gemini-api-key
# Optional: rotate across several keys (comma separated).
# GEMINI_API_KEYS=key-one,key-two

# Optional. Without it the app uses SQLite (local app.db or /tmp on Vercel).
# Use a serverless-friendly pooled Postgres URL in production, e.g. Neon/Vercel Postgres.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: where uploaded question images are written.
# UPLOAD_FOLDER=/tmp/quzo-uploads
